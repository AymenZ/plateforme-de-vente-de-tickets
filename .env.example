# =============================
# Docker Compose environment
# Copy this file to .env at repo root before running compose.
# =============================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=eventdb

# ---- Backend auth ----
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# ---- MongoDB ----
MONGODB_DB_NAME=eventdb_comments

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ---- App URLs ----
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# ---- Gemini moderation ----
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.5-flash
APP_GEMINI_ENABLED=true
APP_GEMINI_ENDPOINT_BASE=https://generativelanguage.googleapis.com/v1beta/models

# ---- Startup behavior ----
# true = run backend/seed_roles.py at container startup
AUTO_SEED=true
